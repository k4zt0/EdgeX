<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ 공통 텍스트 ============ -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,10,0,4" />
  </Style>

  <!-- ============ 메뉴 바 ============ -->
  <Style Selector="Menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="2,0" />
  </Style>
  <Style Selector="Menu > MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Menu > MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource App.Hover}" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter, ContextMenu">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- ============ 버튼 ============ -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Pressed}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- 툴바 버튼: 배경 없이 아이콘/글자만 -->
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="9,5" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
  </Style>

  <!-- 강조 버튼 -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource App.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource App.AccentText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.AccentHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.AccentHover}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource App.AccentText}" />
  </Style>

  <!-- 위험 동작(연결 해제 등) -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource App.Error}" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextInverse}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Error}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- 운전 화면 카드 안의 조작 버튼 -->
  <Style Selector="Button.hmi">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- ============ 토글 버튼 ============ -->
  <Style Selector="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="9,5" />
  </Style>
  <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource App.Text}" />
  </Style>
  <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource App.AccentText}" />
  </Style>
  <Style Selector="ToggleButton.warn:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Error}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Error}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource App.TextInverse}" />
  </Style>

  <!-- ============ 입력 컨트롤 ============ -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="7,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="SelectionBrush" Value="{DynamicResource App.Selection}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>

  <!-- ============ 트리 / 목록 ============ -->
  <Style Selector="TreeView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource App.Selection}" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource App.Selection}" />
  </Style>

  <!-- ============ 문서 탭 (XG5000 스타일) ============ -->
  <Style Selector="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
    <Setter Property="BorderThickness" Value="0,2,0,0" />
  </Style>
  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource App.Hover}" />
  </Style>

  <!-- ============ 표 ============ -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="GridLinesVisibility" Value="All" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="RowBackground" Value="{DynamicResource App.Surface}" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource App.Header}" />
    <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="SeparatorBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource App.Selection}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>

  <!-- ============ 기타 ============ -->
  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource App.Border}" />
  </Style>
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource App.Border}" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource App.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.panelHeader">
    <Setter Property="Background" Value="{DynamicResource App.Header}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
</Styles>
